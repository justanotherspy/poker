ANTHROPIC_API_KEY=
LINEAR_API_KEY=
CONTEXT7_API_KEY=

# Fly.io deploy token (for GitHub Actions secret FLY_API_TOKEN)
FLY_API_TOKEN=

# Comma-separated SHA-256 hashes of MCP API keys (no plaintext keys here)
# Generate: python3 -c "import hashlib,secrets; k=secrets.token_urlsafe(32); print('KEY:',k); print('HASH:',hashlib.sha256(k.encode()).hexdigest())"
MCP_API_KEY_HASHES=

# Upstash Redis connection string (provision via: fly redis create --name claude-poker-redis --region iad)
# If unset, the server runs in single-machine in-memory mode.
REDIS_URL=
