ANTHROPIC_API_KEY=
LINEAR_API_KEY=
CONTEXT7_API_KEY=

# Fly.io deploy token (for GitHub Actions secret FLY_API_TOKEN)
FLY_API_TOKEN=

# Comma-separated SHA-256 hashes of MCP API keys (no plaintext keys here)
# Generate: python3 -c "import hashlib,secrets; k=secrets.token_urlsafe(32); print('KEY:',k); print('HASH:',hashlib.sha256(k.encode()).hexdigest())"
MCP_API_KEY_HASHES=

# Spectator UI password — SHA-256 hex of the shared password. Gates the
# spectator view and game create/delete endpoints. Browser hashes the
# user's password and sends the hex on every request.
# Generate: python3 -c "import hashlib; print(hashlib.sha256(b'YOUR PASSWORD').hexdigest())"
SPECTATOR_PASSWORD_HASH=

# Local-dev plaintext bypass for the spectator password. If set, the
# server accepts it directly (no hashing). Mirrors MCP_DEV_TOKEN.
SPECTATOR_DEV_PASSWORD=

# Upstash Redis connection string (provision via: fly redis create --name claude-poker-redis --region iad)
# If unset, the server runs in single-machine in-memory mode.
REDIS_URL=
