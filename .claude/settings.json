{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); if echo \"$cmd\" | grep -qE '^git commit'; then make lint && make format-check && make semgrep; fi",
            "timeout": 60,
            "statusMessage": "Running ruff + black..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(uv:*)",
      "Bash(gh:*)",
      "Bash(fly:*)",
      "Bash(bun:*)",
      "Bash(docker:*)",
      "Bash(make:*)",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "WebSearch",
      "WebFetch(domain:*)",
      "mcp__context7__*",
      "mcp__github__*",
      "mcp__fly__*",
      "mcp__linear__*",
      "mcp__excalidraw__*",
      "mcp__claude-poker__*",
      "mcp__claude-poker-local__*"
    ]
  }
}
